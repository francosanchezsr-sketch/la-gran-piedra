# Habilita las funciones de IA del configurador. Copia este archivo como
# .env.local y pega tu llave para desarrollo local; en producción se configura
# como variable de entorno en Vercel.
#
# Sin esta llave la app NO truena, pero se apaga: Paso 1, "¿Ya tienes tu propio
# lote?" — no se puede analizar el plano (PDF/imagen) ni la descripción con
# dirección. Sigue funcionando la pestaña "Medidas", que captura frente y
# fondo a mano.
ANTHROPIC_API_KEY=

# Envío de la ficha del arquitecto: el botón "Enviar al arquitecto" del paso 7
# y el "Agenda una cita" rápido del header usan la misma ruta.
#
# Sin RESEND_API_KEY y LGP_CORREO_REMITENTE el botón NO finge: le dice al
# cliente que el envío automático no está activo y lo manda a escribir
# directo. Con ellas, la ficha completa —presupuesto, croquis del lote, zonas,
# paleta y brief— llega al buzón de La Gran Piedra. El cliente no recibe
# copia: esa ficha es la herramienta de trabajo del arquitecto.
#
#   RESEND_API_KEY          llave de https://resend.com
#   LGP_CORREO_REMITENTE    remitente, de un dominio verificado en Resend
#                           (p. ej. "La Gran Piedra <configurador@tudominio.com>")
#   LGP_CORREO_ARQUITECTOS  opcional — a quién le llega, varios separados por
#                           coma. Sin esta variable cae en
#                           contact@lagranpiedrallc.com, ya en el código.
RESEND_API_KEY=
LGP_CORREO_REMITENTE=
LGP_CORREO_ARQUITECTOS=

# Botón de WhatsApp del cierre de la página ("Contacto"). Sin esta variable el
# botón NO se dibuja en producción: hoy no hay número real de La Gran Piedra, y
# un botón que abre un chat con un número inventado le quema al cliente la
# primera impresión. En desarrollo, sin la variable, aparece un aviso apagado
# recordando el pendiente.
#
# Código de país y dígitos, como lo pide wa.me. Acepta también el formato tal
# como se copia del teléfono: "+1 (956) 123-4567".
NEXT_PUBLIC_LGP_WHATSAPP=
